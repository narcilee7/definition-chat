generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Agent {
  id                 String   @id @default(cuid())
  name               String   @unique
  role               String
  tone               String
  color              String
  description        String
  coreTraits         String   @map("core_traits")
  communicationStyle String   @map("communication_style")
  expertise          String   @map("expertise")
  backgroundStory    String?  @map("background_story")
  openingStyle       String   @map("opening_style")
  lengthPreference   String   @map("length_preference")
  forbiddenTopics    String   @map("forbidden_topics")
  systemPrompt       String   @map("system_prompt")
  isBuiltIn          Boolean  @default(false) @map("is_built_in")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("agents")
}

model Session {
  id        String    @id @default(cuid())
  title     String?
  intent    String?
  mood      String?
  notes     String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  messages Message[]

  @@map("sessions")
}

model Message {
  id        String   @id @default(cuid())
  role      String
  content   String
  sessionId String   @map("session_id")
  createdAt DateTime @default(now()) @map("created_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model MemoryNote {
  id          String   @id @default(cuid())
  type        String
  content     String
  confidence  Float    @default(0.5)
  active      Boolean  @default(true)
  sourceIds   String
  linkedTo    String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("memory_notes")
}

model UserContext {
  id            String   @id @default(cuid())
  userId        String   @unique
  aiProfile     String   @map("ai_profile")
  keyTopics     String   @map("key_topics")
  sensitivities String?  @map("sensitivities")
  stylePrefs    String?  @map("style_prefs")
  updatedAt     DateTime @updatedAt @map("updated_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("user_contexts")
}
