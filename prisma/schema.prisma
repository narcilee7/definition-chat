generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// User Layer
// ============================================================

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  phone         String?   @unique
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Privacy & Compliance
  consentGiven  Boolean   @default(false) @map("consent_given")
  consentAt     DateTime? @map("consent_at")
  dataRetention DateTime? @map("data_retention")

  profile       UserProfile?
  sessions      TherapySession[]
  assessments   Assessment[]
  caseFormulations CaseFormulation[]
  safetyPlan    SafetyPlan?
  crisisLogs    CrisisLog[]

  // V4: Lens System
  selfModel     SelfModel?
  explorationSessions ExplorationSession[]
  lenses        Lens[]        @relation("LensAuthor")

  @@map("users")
}

model UserProfile {
  id              String  @id @default(cuid())
  userId          String  @unique @map("user_id")
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Demographics
  nickname        String?
  ageRange        String? @map("age_range")
  gender          String?
  occupation      String?
  relationshipStatus String? @map("relationship_status")

  // Therapy History
  priorTherapy    Boolean @default(false) @map("prior_therapy")
  priorDiagnosis  String? @map("prior_diagnosis")
  medications     String?

  // Preferences
  preferredStyle  String? @map("preferred_style")
  language        String  @default("zh")

  @@map("user_profiles")
}

// ============================================================
// Therapy Layer
// ============================================================

model TherapyApproach {
  id              String  @id @default(cuid())
  name            String  @unique
  displayName     String  @map("display_name")
  description     String
  isBuiltIn       Boolean @default(true) @map("is_built_in")

  // Core Configuration
  sessionStructure Json   @map("session_structure")
  interventionLibrary Json @map("intervention_library")
  assessmentTools  String[] @map("assessment_tools")

  // System Prompt Template
  systemPromptTemplate String @map("system_prompt_template")

  // Community
  createdBy       String? @map("created_by")
  isPublic        Boolean @default(false) @map("is_public")

  personas        TherapistPersona[]

  @@map("therapy_approaches")
}

model TherapistPersona {
  id              String  @id @default(cuid())
  name            String
  description     String

  // Approach
  approachId      String  @map("approach_id")
  approach        TherapyApproach @relation(fields: [approachId], references: [id])

  // Configuration
  systemPrompt    String  @map("system_prompt")
  temperature     Float   @default(0.7)
  maxTokens       Int     @default(1024) @map("max_tokens")

  // Style Parameters
  styleTraits     Json    @map("style_traits")
  voiceTone       String  @map("voice_tone")

  // Specialties
  specialties     String[]

  // Boundaries
  boundaries      String[]

  // Creation
  isBuiltIn       Boolean @default(true) @map("is_built_in")
  createdBy       String? @map("created_by")
  isPublic        Boolean @default(true) @map("is_public")

  sessions        TherapySession[]

  @@map("therapist_personas")
}

model CaseFormulation {
  id              String  @id @default(cuid())
  userId          String  @map("user_id")
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Presenting Problems
  presentingProblems String @map("presenting_problems")

  // Five-Factor Model
  triggers        String?
  thoughts        String?
  emotions        String?
  behaviors       String?
  physical        String?

  // Deep Structure
  coreBeliefs     String[] @map("core_beliefs")
  intermediateBeliefs String[] @map("intermediate_beliefs")
  copingStrategies String[] @map("coping_strategies")

  // Developmental
  formativeEvents String? @map("formative_events")

  // Treatment Plan
  treatmentGoals  Json[]   @map("treatment_goals")

  // Dynamic
  confidence      Float    @default(0.5)
  version         Int      @default(1)
  previousVersion String?  @map("previous_version")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("case_formulations")
}

model TherapySession {
  id              String  @id @default(cuid())
  userId          String  @map("user_id")
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  therapistId     String  @map("therapist_id")
  therapist       TherapistPersona @relation(fields: [therapistId], references: [id])

  // Session Structure
  sessionNumber   Int     @map("session_number")
  phase           String  // V5: engagement, assessment, intervention, closure
  presentingProblem String? @map("presenting_problem")

  // Agenda
  agenda          Json[]

  // Mood Check
  preMood         Json?   @map("pre_mood")
  postMood        Json?   @map("post_mood")

  // Risk
  riskScreening   Json?   @map("risk_screening")
  riskLevel       String  @default("none") @map("risk_level")

  // Content
  messages        SessionMessage[]

  // Outcomes
  insights        String[]
  homework        Json[]
  skillsIntroduced String[] @map("skills_introduced")
  sessionSummary  String?  @map("session_summary")
  summaryGeneratedAt DateTime? @map("summary_generated_at")

  // Alliance
  allianceRating  Int?     @map("alliance_rating")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("therapy_sessions")
}

model SessionMessage {
  id              String  @id @default(cuid())
  sessionId       String  @map("session_id")
  session         TherapySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  role            String  // user, therapist, system, tool
  content         String

  // Structured Annotation
  interventionType String? @map("intervention_type")
  techniqueUsed    String? @map("technique_used")
  riskFlag         Boolean @default(false) @map("risk_flag")

  // Metadata
  latencyMs       Int?    @map("latency_ms")
  tokenCount      Int?    @map("token_count")

  createdAt       DateTime @default(now()) @map("created_at")

  @@map("session_messages")
}

// ============================================================
// Assessment Layer
// ============================================================

model Assessment {
  id              String  @id @default(cuid())
  userId          String  @map("user_id")
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  type            String  // PHQ-9, GAD-7, PSS, WHODAS
  name            String
  description     String?

  // Scale Data
  responses       Json[]
  totalScore      Int     @map("total_score")
  severity        String? // mild, moderate, severe

  // Clinical Significance
  clinicalCutoff  Boolean @default(false) @map("clinical_cutoff")
  riskFlags       String[] @map("risk_flags")

  // Tracking
  sessionId       String? @map("session_id")
  isBaseline      Boolean @default(false) @map("is_baseline")

  createdAt       DateTime @default(now()) @map("created_at")

  @@map("assessments")
}

// ============================================================
// Safety Layer
// ============================================================

model SafetyPlan {
  id              String  @id @default(cuid())
  userId          String  @unique @map("user_id")
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Five Steps (Standard CBT Safety Plan)
  warningSigns    String[] @map("warning_signs")
  copingStrategies String[] @map("coping_strategies")
  distractions    String[]
  supportPeople   Json[]   @map("support_people")
  professionals   Json[]
  environmentSafety String? @map("environment_safety")

  isActive        Boolean  @default(true) @map("is_active")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("safety_plans")
}

model CrisisLog {
  id              String  @id @default(cuid())
  userId          String  @map("user_id")
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Risk Level
  riskLevel       String  @map("risk_level")
  detectedAt      DateTime @default(now()) @map("detected_at")

  // Trigger
  triggerMessage  String? @map("trigger_message")
  triggerType     String? @map("trigger_type")

  // Intervention
  aiResponse      String? @map("ai_response")
  userFollowUp    String? @map("user_follow_up")
  escalated       Boolean @default(false)
  resolvedAt      DateTime? @map("resolved_at")

  // Context
  sessionId       String? @map("session_id")

  @@map("crisis_logs")
}


// ============================================================
// V4: Lens System Layer（与 Therapy Layer 共存，后续逐步迁移）
// ============================================================

model Lens {
  id              String   @id @default(cuid())

  // 基础信息
  name            String
  shortDescription String  @map("short_description")
  description     String?  @db.Text
  domains         String[]

  // Lens 协议（核心）
  sees             String[]
  ignores          String[]
  explainsPainAs   String   @map("explains_pain_as") @db.Text
  coreQuestions    String[] @map("core_questions")
  explorationMoves String[] @map("exploration_moves")
  risks            String[]
  safetyBoundary   String[] @map("safety_boundary")

  // 输出结构与调参
  outputStructure  Json?    @map("output_structure")
  tone             Json?    // { style, temperature, constraints }

  // 作者信息
  authorId    String?  @map("author_id")
  author      User?    @relation("LensAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorName  String?  @map("author_name")
  forkedFrom  String?  @map("forked_from") // 原 Lens ID

  // 可见性
  visibility  String   @default("public")  // public | unlisted | private

  // 统计
  useCount    Int      @default(0) @map("use_count")
  forkCount   Int      @default(0) @map("fork_count")
  avgRating   Float?   @map("avg_rating")

  // 状态
  status      String   @default("active")  // active | deprecated | review

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // 关系
  explorationSessions ExplorationSession[]

  @@map("lenses")
}

model ExplorationSession {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  lensId    String   @map("lens_id")
  lens      Lens     @relation(fields: [lensId], references: [id])

  originalQuestion String @map("original_question")
  phase     String   @default("clarify") // clarify | identify | hypothesize | validate | reframe | experiment | complete

  // 各阶段产物
  clarifiedQuestion String? @map("clarified_question")
  identifiedSignals String[] @map("identified_signals")
  hypothesis        String?
  userValidation    String? @map("user_validation")     // "confirmed" | "revised: ..."
  revisedHypothesis String? @map("revised_hypothesis")
  newNarrative      String? @map("new_narrative")       // 核心产物
  selectedExperiment String? @map("selected_experiment")

  // 关联产物
  selfModelEntryId  String? @unique @map("self_model_entry_id")
  selfModelEntry    SelfModelEntry? @relation(fields: [selfModelEntryId], references: [id])

  // 消息历史
  messages    ExplorationMessage[]

  createdAt   DateTime @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  @@map("exploration_sessions")
}

model ExplorationMessage {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  session   ExplorationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  role      String   // user | lens | system
  content   String
  phase     String   // 当前阶段

  // 元数据
  metadata  Json?    // { signalTag, hypothesisVersion, isPhaseTransition, ... }

  createdAt DateTime @default(now()) @map("created_at")

  @@map("exploration_messages")
}

model SelfModel {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 聚合数据（自动计算缓存）
  topThemes         Json? @map("top_themes")           // [{ theme, count, lastSeenAt }]
  topLenses         Json? @map("top_lenses")           // [{ lensId, lensName, count }]
  recurringPatterns Json? @map("recurring_patterns")   // [{ pattern, frequency, confidence }]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 关系
  entries     SelfModelEntry[]
  experiments Experiment[]

  @@map("self_models")
}

model SelfModelEntry {
  id        String   @id @default(cuid())
  selfModelId String @map("self_model_id")
  selfModel   SelfModel @relation(fields: [selfModelId], references: [id], onDelete: Cascade)

  entryType String   @map("entry_type")  // new_narrative | pattern | insight | shift

  // 核心内容
  originalNarrative String? @map("original_narrative")
  newNarrative      String  @map("new_narrative")

  // 上下文
  lensId      String   @map("lens_id")
  lensName    String   @map("lens_name")
  question    String
  sessionId   String?  @map("session_id")

  // 元数据
  userEdited  Boolean  @default(false) @map("user_edited")
  tags        String[]

  createdAt   DateTime @default(now()) @map("created_at")

  // 反向关系
  explorationSession ExplorationSession?

  @@map("self_model_entries")
}

model Experiment {
  id        String   @id @default(cuid())
  selfModelId String @map("self_model_id")
  selfModel   SelfModel @relation(fields: [selfModelId], references: [id], onDelete: Cascade)

  description String
  sourceLensId String @map("source_lens_id")
  sourceLensName String? @map("source_lens_name")

  status      String   @default("pending")  // pending | active | completed | dropped
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  reflection  String?  // 用户完成后的反思

  createdAt   DateTime @default(now()) @map("created_at")

  @@map("experiments")
}
