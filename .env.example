# ============================================
# OhMe — Environment Configuration
# ============================================

# Database
DATABASE_URL="file:./dev.db"

# API Server
PORT=4000
WEB_URL=http://localhost:3000

# Logging
LOG_LEVEL=info

# ============================================
# LLM Provider (choose ONE)
# ============================================

# Default provider: siliconflow | deepseek | groq | openrouter | openai-compatible
DEFAULT_LLM_PROVIDER=siliconflow

# --- SiliconFlow (硅基流动) — 推荐 ---
# 官网: https://siliconflow.cn
# 特点: 国内直连，超便宜，支持Qwen/Llama/DeepSeek等
SILICONFLOW_API_KEY=your_key_here
SILICONFLOW_MODEL=Qwen/Qwen2.5-7B-Instruct

# --- DeepSeek (深度求索) ---
# 官网: https://platform.deepseek.com
# 特点: 推理能力极强，价格便宜
DEEPSEEK_API_KEY=your_key_here
DEEPSEEK_MODEL=deepseek-chat

# --- Groq ---
# 官网: https://groq.com
# 特点: 超快推理速度
GROQ_API_KEY=your_key_here
GROQ_MODEL=llama-3.1-8b-instant

# --- OpenRouter (fallback) ---
# 官网: https://openrouter.ai
OPENROUTER_API_KEY=your_key_here
OPENROUTER_MODEL=anthropic/claude-3.5-haiku

# --- Generic OpenAI-Compatible ---
# 用于接入任何兼容OpenAI格式的服务商
OPENAI_COMPAT_API_KEY=your_key_here
OPENAI_COMPAT_BASE_URL=https://api.example.com/v1
OPENAI_COMPAT_MODEL=your-model
OPENAI_COMPAT_NAME=generic
